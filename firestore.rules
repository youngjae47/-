rules_version = '2';

// 가족 스케쥴 Firestore 보안 규칙
// - 로그인 없이, "가족 코드"를 아는 사람만 그 가족의 일정을 읽고 쓸 수 있다.
// - 가족 코드는 24자리 무작위 문자라 짐작할 수 없다. (20자 미만 코드는 거절)
// - 전체 가족 목록은 누구도 볼 수 없다. (families 컬렉션 자체에는 규칙이 없음)
// - 일정 내용은 앱이 쓰는 모양(제목 40자, 메모 200자 등)만 허용한다.

service cloud.firestore {
  match /databases/{database}/documents {

    function validCode(code) {
      return code.size() >= 20 && code.size() <= 64 && code.matches('^[a-z0-9]+$');
    }

    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validEvent(d) {
      return d.keys().hasOnly(['title', 'member', 'start', 'end', 'time', 'memo', 'updatedAt',
                               'repeat', 'repeatDays', 'repeatUntil', 'exdates'])
        && d.keys().hasAll(['title', 'member', 'start', 'end', 'time', 'memo', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.member in ['family', 'dad', 'mom', 'suhyun']
        && isDate(d.start)
        && d.end is string && (d.end == '' || (isDate(d.end) && d.end >= d.start))
        && d.time is string && (d.time == '' || d.time.matches('^[0-9]{2}:[0-9]{2}$'))
        && d.memo is string && d.memo.size() <= 200
        && d.updatedAt == request.time
        && validRepeat(d);
    }

    // 반복 일정 (예전에 저장된 일정처럼 반복 필드가 없어도 된다)
    function validRepeat(d) {
      let repeat = d.get('repeat', '');
      let days = d.get('repeatDays', []);
      let until = d.get('repeatUntil', '');
      let exdates = d.get('exdates', []);
      return repeat in ['', 'daily', 'weekly', 'monthly', 'yearly']
        && days is list && days.size() <= 7 && days.toSet().hasOnly([0, 1, 2, 3, 4, 5, 6])
        && until is string && (until == '' || (isDate(until) && until >= d.start))
        && exdates is list && exdates.size() <= 366
        && (repeat == '' || d.end == '');
    }

    match /families/{code}/events/{eventId} {
      allow read, delete: if validCode(code);
      allow create, update: if validCode(code) && validEvent(request.resource.data);
    }

    // 구성원별 목표 (간트차트)
    function validGoal(d) {
      return d.keys().hasOnly(['title', 'member', 'category', 'start', 'end', 'progress', 'memo', 'updatedAt', 'order'])
        && d.keys().hasAll(['title', 'member', 'category', 'start', 'end', 'progress', 'memo', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.member in ['dad', 'mom', 'suhyun']
        && d.category in ['health', 'family', 'self']
        && isDate(d.start) && isDate(d.end) && d.end >= d.start
        && d.progress is int && d.progress >= 0 && d.progress <= 100
        && d.memo is string && d.memo.size() <= 200
        && d.updatedAt == request.time
        && d.get('order', 0) is int && d.get('order', 0) >= 0 && d.get('order', 0) <= 10000;
    }

    match /families/{code}/goals/{goalId} {
      allow read, delete: if validCode(code);
      allow create, update: if validCode(code) && validGoal(request.resource.data);
    }
  }
}
